#!/bin/sh
# Enable once per clone: git config core.hooksPath .githooks
# The feature matrix, audit and container builds run in GitHub Actions.
set -e
if command -v direnv >/dev/null 2>&1 && [ -f .envrc ]; then
  exec direnv exec . cargo xtask ci fmt clippy test markdown
fi
exec cargo xtask ci fmt clippy test markdown
