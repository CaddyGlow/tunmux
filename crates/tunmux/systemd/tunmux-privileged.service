[Unit]
Description=tunmux privileged operations service
After=network.target
Requires=tunmux-privileged.socket

[Service]
Type=simple
# `SocketGroup` in tunmux-privileged.socket controls who can connect to the socket.
# `--authorized-group` controls SO_PEERCRED authorization checks for clients.
ExecStart=/usr/bin/tunmux privileged --serve --authorized-group tunmux
Restart=on-failure

User=root
Group=root

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true

RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RuntimeDirectory=wireguard netns
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ConfigurationDirectory=netns
ConfigurationDirectoryMode=0755
StateDirectory=tunmux
StateDirectoryMode=0700
ReadWritePaths=/run/tunmux /run/wireguard /run/netns /etc/netns /var/lib/tunmux /etc/resolv.conf
SystemCallFilter=@system-service @mount setns unshare
CapabilityBoundingSet=CAP_NET_ADMIN CAP_SYS_ADMIN CAP_DAC_OVERRIDE CAP_CHOWN CAP_KILL
AmbientCapabilities=CAP_NET_ADMIN CAP_SYS_ADMIN CAP_DAC_OVERRIDE CAP_CHOWN CAP_KILL

MemoryMax=256M
TasksMax=64
UMask=0077
